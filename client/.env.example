# Copy to .env for local development (not used in Docker build unless passed as build args).

# Backend API URL (browser must reach this host)
NEXT_PUBLIC_API_URL=http://localhost:3013

# Optional: public site URL for SEO when search indexing is enabled
# NEXT_PUBLIC_SITE_URL=http://localhost:3012

# Keep false on self-hosted installs
# NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=false