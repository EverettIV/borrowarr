# Copy to .env or let the server create .env automatically on first start.
# JWT_* values below are placeholders — `npm run setup:env` or `npm run dev` generates secure secrets.

PORT=3013

# Required (generated automatically if empty or if .env is missing)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SQLite database file (default: server/database.sqlite)
# SQLITE_STORAGE_PATH=

# --- Library + download roots (set on every install) ---
# App uses: {MEDIA}/movies, {MEDIA}/tv, {DOWNLOADS}/movies, {DOWNLOADS}/tv
#
# Docker (match docker-compose mounts — default ./media and ./downloads):
BORROWARR_MEDIA=/media
BORROWARR_DOWNLOADS=/downloads
BORROWARR_ENSURE_MEDIA_DIRS=true
#
# Manual install on the host: use real paths the Node process can read, e.g.
# BORROWARR_MEDIA=/Users/you/borrowarr/media
# BORROWARR_DOWNLOADS=/Users/you/borrowarr/downloads
#
# Optional per-path overrides: BORROWARR_MOVIE_LIBRARY, BORROWARR_SERIES_LIBRARY, etc.

# TMDb metadata (optional; development defaults exist in code)
# Optional: only allow grab http(s) URLs whose host matches a configured indexer (+ allowlist below)
# GRAB_STRICT_INDEXER_HOSTS=false
# GRAB_URL_ALLOWLIST_HOSTS=releases.example.com,cdn.example.org

# TMDb (optional — bundled demo key used when unset; set your own for production)
# TMDB_API=
# TMDB_API_KEY=
# TMDB_API_READ=

# Prowlarr indexer sync (optional)
# PROWLARR_URL=
# PROWLARR_API_KEY=

# FlareSolverr / Cloudflare bypass (optional)
FLARESOLVERR_URL=http://localhost:8191
FLARESOLVERR_ENABLED=false

# Verbose scraper logging
# DEBUG_SCRAPER=false
